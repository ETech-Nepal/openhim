MEDIATOR_PORT=4005
MEDIATOR_URN=urn:mediator:fhir-transform
MEDIATOR_ROUTE_HOST=transform-mediator
INTEGRATIONS_FILE=integrations.json
MAX_BODY_BYTES=1048576

# For isolated local development only, set OPENHIM_REGISTER=false.
# Client identity is still required; disabling registration does not enable public access.
OPENHIM_REGISTER=true
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=
OPENHIM_PASSWORD=
OPENHIM_TRUST_SELF_SIGNED=false
OPENHIM_NETWORK=openhim_openhim

# Required by submission integrations. NHID receives no Authorization header.
NHID_URL=
# FHIR server used to find an existing Patient by national identifier.
FHIR_SERVER_URL=http://fhir:8080/fhir
