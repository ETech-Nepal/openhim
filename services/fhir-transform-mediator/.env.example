MEDIATOR_PORT=4005
MEDIATOR_URN=urn:mediator:fhir-transform
MEDIATOR_ROUTE_HOST=transform-mediator
CONFIG_DIR=/app/config
MAX_BODY_BYTES=1048576
FHIR_VALIDATOR_IG=/config/np.core-1.0.0.tgz

# Channel endpoints named in config/channels.json. Only channels used by apps in
# config/apps.json must be set. URLs and credentials never go in the config files.
VALIDATOR_URL=http://127.0.0.1:8081/validateResource
# nagarik-app-registration-v1 → NHID service (Health ID generation and storage).
NHID_REGISTRATION_URL=https://hiecoretest.mohp.gov.np/healthid/api/generate
# emr-mapper-v1 → OpenHIM "NP FHIR Orchestrator" channel (fhir-mediator → JeMPI → HAPI).
# The transaction Bundle is POSTed to the FHIR base, /fhir.
HAPI_FHIR_CHANNEL_URL=http://openhim-core:5001/fhir
# Sent as Authorization on that channel; the OpenHIM client needs the np-fhir-clients role.
HAPI_FHIR_CHANNEL_AUTHORIZATION=
# normal-mapper-v1 has no delivery channel: it returns the validated FHIR.

# For isolated local development only, set OPENHIM_REGISTER=false.
# Client identity is still required; disabling registration does not enable public access.
OPENHIM_REGISTER=true
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=
OPENHIM_PASSWORD=
OPENHIM_TRUST_SELF_SIGNED=false
OPENHIM_NETWORK=openhim_openhim
