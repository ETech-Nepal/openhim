{
  "route": "/transform/patient",
  "channel": "transform",
  "role": "transform-clients",
  "input": {
    "strict": false,
    "fields": {
      "national_id": {
        "path": "$.national_id",
        "required": true,
        "maxLength": 100
      },
      "given_name": {
        "path": "$.given_name",
        "required": true,
        "maxLength": 100
      },
      "family_name": {
        "path": "$.family_name",
        "required": true,
        "maxLength": 100
      },
      "gender": {
        "path": "$.gender",
        "required": true,
        "enum": ["male", "female", "other", "unknown"],
        "rule": "must be one of male, female, other, unknown"
      },
      "birth_date": {
        "path": "$.birth_date",
        "required": true,
        "format": "date",
        "rule": "must be a date in YYYY-MM-DD format"
      },
      "mobile": {
        "path": "$.mobile",
        "pattern": "\\+977\\d{10}",
        "rule": "must be +977 followed by 10 digits"
      }
    }
  },
  "resources": [{ "key": "patient", "mapping": "patient.np-core.v1" }],
  "validation": {
    "channel": "validator",
    "profile": "http://fhir.digitalhealth.gov.np/core/StructureDefinition/np-core-patient",
    "ignore": [
      "Slice 'Patient.identifier:healthId': a matching slice is required, but not found"
    ]
  }
}
