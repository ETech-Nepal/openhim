MEDIATOR_PORT=4004
MEDIATOR_URN=urn:mediator:np-fhir-gateway
MEDIATOR_ROUTE_HOST=fhir-gateway-mediator
NODE_ENV=development
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=
OPENHIM_TRUST_SELF_SIGNED=true
# OpenHIM client roles allowed onto the /fhir channel. Fine-grained access comes from
# the Keycloak realm role in the token, not from these.
OPENHIM_CHANNEL_ROLES=fhir-read,fhir-write
# Keycloak realm that signs client tokens. JWKS is fetched from <issuer>/protocol/openid-connect/certs.
KEYCLOAK_ISSUER=https://hiecore.mohp.gov.np/realms/hie
KEYCLOAK_AUDIENCE=account
# Only if the issuer URL is not reachable from inside the container (local dev):
# KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/openhie/protocol/openid-connect/certs
# Public URL clients use to reach OpenHIM. DPoP `htu` must match <this>/fhir/...
PUBLIC_BASE_URL=https://hie.example.org
HAPI_BASE_URL=http://fhir:8080/fhir
# Set true when HAPI_BASE_URL is an hie-fhir-server style image that enforces roles from
# X-Role. Then realm_access.roles are mapped via ROLE_MAPPINGS and one broad channel is
# registered for OPENHIM_CHANNEL_ROLES. Leave false for stock HAPI (per-role channels).
UPSTREAM_ROLE_HEADER=false
ROLE_MAPPINGS=hip=ehr,hiu=patient
OPENHIM_CHANNEL_ROLES=fhir-read,fhir-write
